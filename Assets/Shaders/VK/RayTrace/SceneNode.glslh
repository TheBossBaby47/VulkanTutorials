struct GLTFPrimInfo
{
  uint vertexOffset;
  uint indexOffset;
  int materialLayerID;
};

struct Texture 
{
    ivec2 dimensions; // Equivalent to Vector2i in C++
    uint assetID;     // Equivalent to uint32_t in C++
};

struct GLTFMaterialLayer 
{
  int albedoId;
  int bumpId;
  int occlusionId;
  int emissionId;
  int metallicRoughnessId;
};

struct PointLight
{
  vec3 position;
  vec4 color;
  float radius;
  float intensity;
};

struct PointLightCpp
{
  vec3 position;
  float radius;
  vec4 color;
};