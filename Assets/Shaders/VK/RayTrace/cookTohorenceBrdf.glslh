const float PI = 3.14159265359f;

vec4 LambartianDiffuse(vec4 inAlbedo)
{
    return inAlbedo / PI;
}

//Specular NDF
float GGXSpecular(float inRoughness, vec3 inN, vec3 inH)
{
    const float alpha = inRoughness * inRoughness;
    const float alpha2 = pow(alpha, 2);
    const float nDotH2 = pow(clamp(dot(inN, inH), 0.0f, 1.0f), 2);

    const float numerator = alpha2;
    const float denominator = PI * pow(((nDotH2) * (alpha2 - 1.0f) + 1), 2);

    return numerator / denominator;
}

//If inX is light direction then we are seing shadow else if direction is eye we are seeing mask.
float SchilkGeometric(float inRoughness, vec3 inN, vec3 inX)
{
    const float remapedRoughness = (inRoughness + 1.0f) / 2.0f;
    const float alpha = remapedRoughness * remapedRoughness;
    const float k = alpha / 2.0f;

    const float numerator =  clamp(dot(inN , inX), 0.0f , 1.0f);
    const float denominator = (numerator * (1.0f - k)) + k;

    return numerator / denominator; 
}

float GeometricAttenuation(float inRoughness, vec3 inL, vec3 inV, vec3 inN)
{
    return SchilkGeometric(inRoughness, inN, inL) * SchilkGeometric(inRoughness, inN, inV);
}

vec3 SchlickFresnel(vec3 inV, vec3 inH, vec3 inAlbedo, float inMetallic)
{
    const float vDotH = clamp(dot(inV,inH), 0.0f, 1.0f);
    const vec3 f0 = mix(vec3(0.04, 0.04, 0.04), inAlbedo, inMetallic);

    return f0 + ((1 - f0) * pow(clamp(1.0f - vDotH, 0.0f, 1.0f), 5.0f));
}

vec3 MicrofacetSpecularBrdf(const float inMetallic, const float inRoughness, const vec3 inAlbedo,  const vec3 inN, const vec3 inL, const vec3 inV)
{
    const vec3 H = normalize(inV + inL);
    const float D = GGXSpecular(inRoughness, inN, H);
    const vec3 F = SchlickFresnel(inV, H, inAlbedo, inMetallic);
    const float G = GeometricAttenuation(inRoughness, inL, inV, inN);

    const float nDotL = clamp(dot(inN, inL), 0.001f, 1.0f);
    const float nDotV = clamp(dot(inN, inV), 0.001f, 1.0f);

    const vec3 numerator = D * F * G;
    const float denominator = 4 * nDotL * nDotV;
    vec3 specularBrdf = numerator / denominator;

    const vec3 kS = F;
    const vec3 kD = vec3(1.0f) - kS;
    const vec3 diffuseBrdf = LambartianDiffuse(vec4(inAlbedo, 1.0f)).rgb;
    return (kD * diffuseBrdf)  +  specularBrdf;
}

float PointLightAttenuation(const float inDistance, const float inLightRadius)
{
    const float normalizedDistance =  inDistance / inLightRadius;
    const float ratio4 = normalizedDistance * normalizedDistance * normalizedDistance * normalizedDistance;

    const float saturation = clamp(1.0f - ratio4, 0.0f, 1.0f);

    const float numerator = saturation * saturation;

    //The 1 in the denominator is there to prevent the function exploding at distances close to the light
    //source. It can be exposed as an artist-controllable parameter for cases where physical correctness isn’t
    //desired.    
    const float denominator = (inDistance * inDistance) + 1.0f;

    return numerator / denominator;
}

vec4 Reinhard(const vec4 inV)
{
    return vec4(
        inV.rgb / (1.0f + inV.rgb),
        1.0f);
}

vec3 GetNormalFromTexture(vec3 inTexNormal, vec3 inVNormal, vec4 inVTangent)
{
    vec3 outNormal = vec3(0);
    vec3 bumpNormal = normalize(inTexNormal * 2.0 - 1.0);

    mat3x4 normalMatrix = transpose(gl_WorldToObjectEXT);

    vec3 wNormal = normalize(normalMatrix * normalize(inVNormal)).xyz;
    vec3 wTangent = normalize(normalMatrix * normalize(inVTangent.xyz)).xyz;
    vec3 wBiTangent = cross(wTangent, wNormal) * inVTangent.w;

    const mat3 TBN = mat3(wTangent,
                    wBiTangent,
                    wNormal);
                    
    outNormal = normalize(TBN * bumpNormal);
    return outNormal;
}